<mxfile host="app.diagrams.net"><diagram id="data_flowchart" name="data_flowchart"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="2100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="NutriEmpath-VN – Data construction, training and evaluation" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="src1" value="Psychology sources:&lt;br&gt;ESConv 2,376 · EmpatheticDialogues 1,088&lt;br&gt;CACTUS 690 · counsel-chat 443 · Student-10K 296" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="340" height="80" as="geometry"/></mxCell><mxCell id="src2" value="Nutrition sources:&lt;br&gt;PubMed · EU Reg. 432/2012&lt;br&gt;VN FCT 2007 · USDA FDC" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="50" width="320" height="80" as="geometry"/></mxCell><mxCell id="t1" value="Task 1 – Psychological counseling&lt;br&gt;4,893 samples&lt;br&gt;(situation, counseling technique, sample response)" style="whiteSpace=wrap;html=1;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="340" height="90" as="geometry"/></mxCell><mxCell id="t2" value="Task 2 – Nutrition knowledge&lt;br&gt;422 symptom → nutrient → food pairs&lt;br&gt;(30 [WARNING] entries advising limitation)" style="whiteSpace=wrap;html=1;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="320" height="90" as="geometry"/></mxCell><mxCell id=