ures (loss, PPL)" style="whiteSpace=wrap;html=1;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="1330" width="260" height="70" as="geometry"/></mxCell><mxCell id="select" value="Select epoch 3&lt;br&gt;(Gating F1 0.991, no false triggers&lt;br&gt;Symptom EM 0.725 · Group C safe 100%)" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="1340" width="400" height="130" as="geometry"/></mxCell><mxCell id="deploy" value="Proposed model: NutriEmpath-VN&lt;br&gt;Qwen2.5-7B-Instruct + LoRA (epoch 3)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="1520" width="340" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src1" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src2" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="t1" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="300"/><mxPoint x="345" y="300"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="t2" target="gen"><mxGeomet