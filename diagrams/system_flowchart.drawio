<mxfile host="app.diagrams.net"><diagram id="system_flowchart" name="system_flowchart"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="2100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="NutriEmpath-VN – Proposed model: symptom-gated nutrition advice" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="start" value="Student message&lt;br&gt;(Vietnamese, aged 13–18)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="220" height="55" as="geometry"/></mxCell><mxCell id="prompt" value="ChatML input&lt;br&gt;system: &quot;You are a companion of students.&quot;&lt;br&gt;user: message" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="300" height="70" as="geometry"/></mxCell><mxCell id="model" value="NutriEmpath-VN&lt;br&gt;Qwen2.5-7B-Instruct + LoRA (r = 16, epoch 3)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="250" width="300" height="70" as="geometry"/></mxCell><mxCell id="know" value="&lt;b&gt;Knowledge learned from fine-tuning data&lt;/b&gt;&lt;br&gt;Task 1: empathetic responses (4,893 samples)&lt;br&gt;Task 2: symptom → nutrient → food (422 entries)&lt;br&gt;Task 3: gated dialogues, Groups A / B / C (4,428)" style="whiteSpace=wrap;html=1;fontSize=12;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="660" y="245" width="340" height="85" as="geometry"/></mxCell><mxCell